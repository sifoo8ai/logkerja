{
    "manifest_version": 3,
    "name": "LogKerja SidePanel",
    "version": "1.1.0",
    "description": "LogKerja App in Chrome SidePanel + tangkapan Requisition dari ERP UPM",
    "permissions": [
        "sidePanel",
        "storage"
    ],
    "host_permissions": [
        "https://erp.upm.edu.my/*"
    ],
    "background": {
        "service_worker": "service_worker.js"
    },
    "side_panel": {
        "default_path": "sidepanel.html"
    },
    "content_scripts": [
        {
            "matches": ["https://erp.upm.edu.my/*"],
            "js": ["erp-capture.js"],
            "all_frames": true,
            "run_at": "document_idle"
        }
    ],
    "options_ui": {
        "page": "options.html",
        "open_in_tab": false
    },
    "icons": {
        "16": "icons/16.png",
        "32": "icons/32.png",
        "48": "icons/48.png",
        "128": "icons/128.png"
    },
    "action": {
        "default_title": "Open LogKerja Side Panel",
        "default_icon": {
            "16": "icons/16.png",
            "32": "icons/32.png",
            "48": "icons/48.png",
            "128": "icons/128.png"
        }
    }
}
